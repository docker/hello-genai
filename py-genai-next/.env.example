# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
# Separate secret used to hash Personal Access Tokens at rest (do not reuse SECRET_KEY)
PAT_PEPPER=change-me-to-a-different-long-random-string
# Comma-separated emails auto-promoted to admin on registration
ADMIN_EMAILS=
ENV=development
LOG_LEVEL=INFO

# ── LLM backend (OpenAI-compatible, e.g. Docker Model Runner) ──────────────────
LLAMA_URL=http://host.docker.internal:12434/engines/llama.cpp/v1
LLAMA_MODEL=docker.io/ai/gemma4:latest
AVAILABLE_MODELS=docker.io/ai/gemma4:latest,docker.io/ai/gemma3n:latest

# ── Embeddings (RAG + semantic memory via pgvector) ───────────────────────────
# Pull an embedding model in Docker Model Runner and set its id + dimension.
EMBED_MODEL=docker.io/ai/mxbai-embed-large:latest
EMBED_DIM=1024

# ── Tools ─────────────────────────────────────────────────────────────────────
# Let the model call built-in tools; WEB_SEARCH_ENABLED adds live web_search + fetch_url.
TOOLS_ENABLED=true
WEB_SEARCH_ENABLED=true

# ── Postgres (defaults match docker-compose) ──────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=genai
POSTGRES_PASSWORD=genai
POSTGRES_DB=genai

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Frontend build ────────────────────────────────────────────────────────────
# Leave EMPTY (recommended): the SPA calls the API same-origin through the nginx
# proxy, so it works from any device on your network (phone, tablet) with no
# hostname baked in at build time. Only set this to point the SPA at a backend
# on a different origin — then you must also add that origin to CORS_ORIGINS.
VITE_API_URL=
