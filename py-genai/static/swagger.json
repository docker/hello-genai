{
  "openapi": "3.0.0",
  "info": {
    "title": "Hello-GenAI API",
    "description": "REST API for the Hello-GenAI local chat application powered by Docker Model Runner.",
    "version": "2.0.0"
  },
  "servers": [
    { "url": "/", "description": "Current server" }
  ],
  "tags": [
    { "name": "Chat",     "description": "Send messages and stream responses" },
    { "name": "Models",   "description": "List available Docker Model Runner models" },
    { "name": "Sessions", "description": "Create and manage conversation sessions" },
    { "name": "Messages", "description": "Message history and editing" },
    { "name": "Search",   "description": "Full-text search across all conversations" },
    { "name": "Presets",  "description": "Saved system prompt presets" },
    { "name": "Memory",   "description": "Persistent facts about the user, recalled in every conversation" },
    { "name": "Feedback", "description": "Per-message thumbs up / down feedback" },
    { "name": "Stats",    "description": "Aggregate token usage statistics" },
    { "name": "Backup",   "description": "Full export/import and file extraction" },
    { "name": "System",   "description": "Health check, runtime config, and web interface" }
  ],
  "components": {
    "parameters": {
      "session_id": {
        "name": "session_id",
        "in": "path",
        "required": true,
        "description": "UUID of the session",
        "schema": { "type": "string", "format": "uuid" },
        "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
      },
      "message_id": {
        "name": "message_id",
        "in": "path",
        "required": true,
        "description": "Integer ID of the message",
        "schema": { "type": "integer" },
        "example": 42
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Message is required" }
        }
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        }
      },
      "TokenUsage": {
        "type": "object",
        "example": { "prompt_tokens": 42, "completion_tokens": 128, "total_tokens": 170 },
        "properties": {
          "prompt_tokens":     { "type": "integer", "example": 42 },
          "completion_tokens": { "type": "integer", "example": 128 },
          "total_tokens":      { "type": "integer", "example": 170 }
        }
      },
      "Session": {
        "type": "object",
        "example": {
          "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "title": "How does Docker work?",
          "system_prompt": null,
          "model": "docker.io/ai/gemma3n:latest",
          "pinned": 0,
          "created_at": "2024-01-01T00:00:00+00:00",
          "updated_at": "2024-01-01T00:01:00+00:00"
        },
        "properties": {
          "id":            { "type": "string",  "format": "uuid" },
          "title":         { "type": "string",  "example": "How does Docker work?" },
          "system_prompt": { "type": "string",  "nullable": true },
          "model":         { "type": "string",  "nullable": true, "description": "Model used when this session was first created", "example": "docker.io/ai/gemma3n:latest" },
          "pinned":        { "type": "integer", "enum": [0, 1] },
          "created_at":    { "type": "string",  "format": "date-time" },
          "updated_at":    { "type": "string",  "format": "date-time" }
        }
      },
      "Message": {
        "type": "object",
        "example": {
          "id": 1,
          "session_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "role": "user",
          "content": "What is a container?",
          "token_usage": null,
          "feedback": null,
          "created_at": "2024-01-01T00:00:00+00:00"
        },
        "properties": {
          "id":          { "type": "integer" },
          "session_id":  { "type": "string", "format": "uuid" },
          "role":        { "type": "string", "enum": ["user", "assistant"] },
          "content":     { "type": "string" },
          "token_usage": { "$ref": "#/components/schemas/TokenUsage", "nullable": true },
          "feedback":    { "type": "string", "enum": ["up", "down"], "nullable": true },
          "complete":    { "type": "integer", "enum": [0, 1], "description": "0 if the response was interrupted (stopped or errored) before it finished" },
          "model":       { "type": "string", "nullable": true, "description": "Model that produced this message (assistant messages)" },
          "created_at":  { "type": "string", "format": "date-time" }
        }
      },
      "Preset": {
        "type": "object",
        "example": { "id": 1, "name": "Concise", "text": "You are a concise assistant.", "created_at": "2024-01-01T00:00:00+00:00" },
        "properties": {
          "id":         { "type": "integer" },
          "name":       { "type": "string", "maxLength": 60 },
          "text":       { "type": "string", "maxLength": 2000 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Memory": {
        "type": "object",
        "example": {
          "id": 1,
          "content": "User prefers concise answers with code examples",
          "source_session_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "enabled": 1,
          "created_at": "2024-01-01T00:00:00+00:00",
          "updated_at": "2024-01-01T00:00:00+00:00"
        },
        "properties": {
          "id":                { "type": "integer" },
          "content":           { "type": "string", "maxLength": 300 },
          "source_session_id": { "type": "string", "format": "uuid", "nullable": true, "description": "Session the fact was extracted from; null for manually added memories" },
          "enabled":           { "type": "integer", "enum": [0, 1], "description": "Disabled memories stay stored but are not recalled" },
          "created_at":        { "type": "string", "format": "date-time" },
          "updated_at":        { "type": "string", "format": "date-time" }
        }
      },
      "SearchResult": {
        "type": "object",
        "example": {
          "message_id": 42,
          "session_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
          "role": "assistant",
          "title": "Docker basics",
          "snippet": "A [MARK]container[/MARK] is a lightweight …"
        },
        "properties": {
          "message_id": { "type": "integer" },
          "session_id": { "type": "string", "format": "uuid" },
          "role":       { "type": "string", "enum": ["user", "assistant"] },
          "title":      { "type": "string", "description": "Title of the session containing the match" },
          "snippet":    { "type": "string", "description": "Matching text excerpt; matched terms are wrapped in [MARK]…[/MARK]" }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["message"],
        "example": {
          "message": "What is a container?",
          "session_id": null,
          "model": null,
          "system_prompt": null,
          "temperature": null,
          "max_tokens": null
        },
        "properties": {
          "message":       { "type": "string", "maxLength": 32000, "example": "What is a container?", "description": "Max length configurable via MAX_MESSAGE_LEN (default 32000)" },
          "session_id":    { "type": "string", "format": "uuid", "nullable": true, "description": "Omit to chat without session history" },
          "model":         { "type": "string", "nullable": true, "example": "docker.io/ai/gemma4:latest", "description": "Overrides the server default model" },
          "system_prompt": { "type": "string", "nullable": true, "description": "Overrides the session or default system prompt" },
          "temperature":   { "type": "number", "minimum": 0, "maximum": 2, "nullable": true, "example": 0.7, "description": "Sampling temperature, clamped server-side to 0–2. Omit to use the model default." },
          "max_tokens":    { "type": "integer", "minimum": 1, "maximum": 32768, "nullable": true, "example": 512, "description": "Maximum response length in tokens, clamped server-side to 1–32768. Omit to use the model default." },
          "save":          { "type": "boolean", "default": true, "description": "Set false to run with session context but persist nothing (used by compare mode)" },
          "images":        { "type": "array", "items": { "type": "string" }, "description": "Inline image data URLs (data:image/…) for vision-capable models", "example": [] },
          "use_memory":    { "type": "boolean", "default": true, "description": "Set false to skip recalling stored memories and extracting new facts for this request" }
        }
      },
      "ImportRequest": {
        "type": "object",
        "required": ["messages"],
        "example": {
          "title": "Imported Chat",
          "system_prompt": null,
          "messages": [
            { "role": "user",      "content": "Hello!" },
            { "role": "assistant", "content": "Hi there! How can I help?" }
          ]
        },
        "properties": {
          "title":         { "type": "string", "example": "Imported Chat" },
          "system_prompt": { "type": "string", "nullable": true },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role":    { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Chat web interface",
        "responses": {
          "200": { "description": "HTML chat application" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check",
        "description": "Returns application health and Docker Model Runner reachability. With `deep=1`, also verifies that the configured model is actually loaded on the backend and reports `status: degraded` if not.",
        "parameters": [
          {
            "name": "deep",
            "in": "query",
            "required": false,
            "description": "Set to 1 to verify the configured model is loaded on the LLM backend",
            "schema": { "type": "integer", "enum": [0, 1] },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "status": "healthy",
                    "llm_api": "ok",
                    "model": "docker.io/ai/gemma4:latest",
                    "timestamp": "2024-01-01T00:00:00+00:00"
                  },
                  "properties": {
                    "status":       { "type": "string", "enum": ["healthy", "degraded"], "example": "healthy" },
                    "llm_api":      { "type": "string", "enum": ["ok", "not_configured", "unreachable"] },
                    "model":        { "type": "string", "example": "docker.io/ai/gemma4:latest" },
                    "model_loaded": { "type": "boolean", "nullable": true, "description": "Only present with deep=1 — whether the configured model is loaded on the backend" },
                    "timestamp":    { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "503": { "description": "Degraded — with deep=1, the configured model is not loaded on the backend" }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": ["Search"],
        "summary": "Full-text search across all conversations",
        "description": "Searches message content in every session using SQLite FTS5 with prefix matching. Returns up to 30 ranked matches with highlighted snippets.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search terms (matched as prefixes, e.g. `dock` matches `docker`)",
            "schema": { "type": "string" },
            "example": "docker container"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "$ref": "#/components/schemas/SearchResult" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/presets": {
      "get": {
        "tags": ["Presets"],
        "summary": "List system prompt presets",
        "responses": {
          "200": {
            "description": "Presets ordered by name",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Preset" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Presets"],
        "summary": "Create a preset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "text"],
                "properties": {
                  "name": { "type": "string", "maxLength": 60, "example": "Concise" },
                  "text": { "type": "string", "maxLength": 2000, "example": "You are a concise assistant." }
                }
              },
              "example": { "name": "Concise", "text": "You are a concise assistant." }
            }
          }
        },
        "responses": {
          "201": { "description": "Preset created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Preset" } } } },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/presets/{preset_id}": {
      "delete": {
        "tags": ["Presets"],
        "summary": "Delete a preset",
        "parameters": [
          {
            "name": "preset_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": ["Chat"],
        "summary": "Non-streaming chat",
        "description": "Sends a message and waits for the complete response. Persists to session history if `session_id` is provided.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "example": {
                "message": "What is a container?"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "response": "A container is a lightweight, portable unit...",
                    "usage": { "prompt_tokens": 42, "completion_tokens": 128, "total_tokens": 170 },
                    "message_id": null
                  },
                  "properties": {
                    "response":   { "type": "string" },
                    "usage":      { "$ref": "#/components/schemas/TokenUsage" },
                    "message_id": { "type": "integer", "nullable": true, "description": "DB ID of the saved assistant message" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error",    "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "500": { "description": "Server error",        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/stream": {
      "post": {
        "tags": ["Chat"],
        "summary": "Streaming chat (SSE)",
        "description": "Streams the response as Server-Sent Events. Three event types are emitted:\n\n- `start` — fired once before tokens; includes `user_message_id`\n- `token` — one chunk of streamed text\n- `done` — stream complete; includes `usage`, `message_id`, `is_first`\n- `error` — error string",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "example": {
                "message": "Explain Docker networking in simple terms."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" },
                "example": "data: {\"start\": true, \"user_message_id\": 1}\n\ndata: {\"token\": \"Hello\"}\n\ndata: {\"done\": true, \"usage\": {}, \"message_id\": 2, \"is_first\": true}\n\n"
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": ["Models"],
        "summary": "List available models",
        "description": "Discovers the models the LLM backend currently exposes (live). `AVAILABLE_MODELS` / `LLAMA_MODEL` are used only as a fallback when the backend is unreachable. Responses are cached for 30s; pass any query string (e.g. `?refresh=<ts>`) to bypass the cache.",
        "parameters": [
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "description": "Any value bypasses the 30s response cache and forces live re-discovery",
            "schema": { "type": "string" },
            "example": "1720000000000"
          }
        ],
        "responses": {
          "200": {
            "description": "Model list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "models": ["docker.io/ai/gemma4:latest", "docker.io/ai/gemma3n:latest"],
                    "current": "docker.io/ai/gemma4:latest",
                    "source": "live"
                  },
                  "properties": {
                    "models":  { "type": "array", "items": { "type": "string" } },
                    "current": { "type": "string", "description": "Suggested default: the configured model if available, else the first model" },
                    "source":  { "type": "string", "enum": ["live", "fallback"], "description": "`live` = discovered from the backend; `fallback` = backend unreachable, using configured models" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": ["Sessions"],
        "summary": "List all sessions",
        "description": "Returns all sessions ordered by pinned status then last updated.",
        "responses": {
          "200": {
            "description": "Array of sessions",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Session" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Sessions"],
        "summary": "Create a session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title":         { "type": "string", "example": "New Chat" },
                  "system_prompt": { "type": "string", "nullable": true, "example": null }
                }
              },
              "example": {
                "title": "New Chat",
                "system_prompt": null
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "session_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6" },
                  "properties": {
                    "session_id": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/import": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Import a conversation from JSON",
        "description": "Creates a new session and bulk-inserts the provided messages. Useful for restoring exported chats.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ImportRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "session_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6" },
                  "properties": {
                    "session_id": { "type": "string", "format": "uuid" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "parameters": [
        { "$ref": "#/components/parameters/session_id" }
      ],
      "patch": {
        "tags": ["Sessions"],
        "summary": "Update session title, system prompt, or model",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title":         { "type": "string", "example": "Renamed conversation" },
                  "system_prompt": { "type": "string", "nullable": true, "example": "You are a concise assistant." },
                  "model":         { "type": "string", "nullable": true, "example": "docker.io/ai/gemma3n:latest" }
                }
              },
              "example": {
                "title": "Renamed conversation"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "404": { "description": "Session not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "tags": ["Sessions"],
        "summary": "Delete session and all its messages",
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/sessions/{session_id}/pin": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Pin or unpin a session",
        "description": "Pinned sessions appear at the top of the sidebar list.",
        "parameters": [
          { "$ref": "#/components/parameters/session_id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pinned": { "type": "boolean", "example": true }
                }
              },
              "example": { "pinned": true }
            }
          }
        },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/sessions/{session_id}/generate-title": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Auto-generate session title",
        "description": "Calls the LLM in a background thread to generate a 4–6 word title from the first message. Returns 202 immediately.",
        "parameters": [
          { "$ref": "#/components/parameters/session_id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": { "type": "string", "description": "The first user message to base the title on", "example": "What is a container?" }
                }
              },
              "example": { "message": "What is a container?" }
            }
          }
        },
        "responses": {
          "202": { "description": "Title generation started", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
      "get": {
        "tags": ["Messages"],
        "summary": "Get session messages",
        "description": "Returns all messages in chronological order with token usage and feedback.",
        "parameters": [
          { "$ref": "#/components/parameters/session_id" }
        ],
        "responses": {
          "200": {
            "description": "Message list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/messages/from/{message_id}": {
      "delete": {
        "tags": ["Messages"],
        "summary": "Truncate messages from a point",
        "description": "Deletes this message and all messages that follow it. Used by the edit feature to reset context.",
        "parameters": [
          { "$ref": "#/components/parameters/session_id" },
          { "$ref": "#/components/parameters/message_id" }
        ],
        "responses": {
          "200": { "description": "Messages truncated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/sessions/{session_id}/export": {
      "get": {
        "tags": ["Sessions"],
        "summary": "Export session as Markdown or JSON",
        "description": "Downloads the full conversation. The default format is Markdown; `format=json` produces a file that round-trips through `POST /api/sessions/import`.",
        "parameters": [
          { "$ref": "#/components/parameters/session_id" },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Export format: `md` (default) or `json` (re-importable)",
            "schema": { "type": "string", "enum": ["md", "json"], "default": "md" },
            "example": "json"
          }
        ],
        "responses": {
          "200": {
            "description": "File download",
            "content": {
              "text/markdown": { "schema": { "type": "string" } },
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "title": "Docker basics",
                    "system_prompt": null,
                    "model": "docker.io/ai/gemma4:latest",
                    "exported_at": "2024-01-01T00:01:00+00:00",
                    "messages": [
                      { "role": "user", "content": "What is a container?" },
                      { "role": "assistant", "content": "A container is…" }
                    ]
                  }
                }
              }
            }
          },
          "404": { "description": "Session not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/messages/{message_id}/feedback": {
      "post": {
        "tags": ["Feedback"],
        "summary": "Set message feedback",
        "description": "Stores thumbs-up or thumbs-down feedback for a message. Send `null` to clear.",
        "parameters": [
          { "$ref": "#/components/parameters/message_id" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["feedback"],
                "properties": {
                  "feedback": { "type": "string", "enum": ["up", "down"], "nullable": true, "description": "Send null to clear feedback" }
                }
              },
              "example": { "feedback": "up" }
            }
          }
        },
        "responses": {
          "200": { "description": "Feedback saved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "Aggregate token usage statistics",
        "description": "Aggregates token usage across all sessions from the SQLite database.",
        "responses": {
          "200": {
            "description": "Aggregated stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "total_sessions": 12,
                    "total_messages": 84,
                    "prompt_tokens": 9200,
                    "completion_tokens": 4100,
                    "total_tokens": 13300
                  },
                  "properties": {
                    "total_sessions":     { "type": "integer" },
                    "total_messages":     { "type": "integer" },
                    "prompt_tokens":      { "type": "integer" },
                    "completion_tokens":  { "type": "integer" },
                    "total_tokens":       { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": ["System"],
        "summary": "Public runtime configuration",
        "description": "Non-secret settings the frontend needs (context budget, attachment limits, whether auth and memory are enabled).",
        "responses": {
          "200": {
            "description": "Config",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "context_max_tokens": 3000,
                    "max_message_len": 32000,
                    "max_images_per_message": 4,
                    "max_image_bytes": 4194304,
                    "auth_enabled": false,
                    "memory_enabled": true,
                    "memory_max_items": 100
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/memories": {
      "get": {
        "tags": ["Memory"],
        "summary": "List memories",
        "description": "All stored facts about the user, including disabled ones.",
        "responses": {
          "200": {
            "description": "Memories in creation order",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Memory" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Memory"],
        "summary": "Add a memory manually",
        "description": "Duplicate content (case-insensitive) is not stored twice — the existing memory's id is returned.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["content"],
                "properties": {
                  "content": { "type": "string", "maxLength": 300, "example": "User's name is Anirban" }
                }
              },
              "example": { "content": "User's name is Anirban" }
            }
          }
        },
        "responses": {
          "201": { "description": "Memory stored", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Memory" } } } },
          "400": { "description": "Missing content", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Memory is full (MEMORY_MAX_ITEMS reached)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "tags": ["Memory"],
        "summary": "Forget everything",
        "description": "Deletes all stored memories.",
        "responses": {
          "200": {
            "description": "Cleared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "ok": true, "deleted": 7 },
                  "properties": {
                    "ok":      { "type": "boolean" },
                    "deleted": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/memories/{memory_id}": {
      "parameters": [
        {
          "name": "memory_id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" },
          "example": 1
        }
      ],
      "patch": {
        "tags": ["Memory"],
        "summary": "Edit or pause a memory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": { "type": "string", "maxLength": 300 },
                  "enabled": { "type": "boolean", "description": "false pauses the memory without deleting it" }
                }
              },
              "example": { "enabled": false }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } },
          "400": { "description": "Invalid content", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "delete": {
        "tags": ["Memory"],
        "summary": "Forget one memory",
        "responses": {
          "200": { "description": "Deleted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } } }
        }
      }
    },
    "/api/backup": {
      "get": {
        "tags": ["Backup"],
        "summary": "Export a full backup",
        "description": "Downloads every conversation (with messages) and all presets as a single JSON file that can be restored via POST.",
        "responses": {
          "200": {
            "description": "Backup file",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      },
      "post": {
        "tags": ["Backup"],
        "summary": "Restore a full backup",
        "description": "Recreates sessions, messages, and presets from a backup produced by GET /api/backup.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessions"],
                "properties": {
                  "sessions": { "type": "array", "items": { "type": "object" } },
                  "presets":  { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Restored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "imported_sessions": 12 },
                  "properties": { "imported_sessions": { "type": "integer" } }
                }
              }
            }
          },
          "400": { "description": "Invalid backup", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/extract": {
      "post": {
        "tags": ["Backup"],
        "summary": "Extract text from an uploaded PDF",
        "description": "Multipart upload (`file`) of a PDF; returns extracted plain text for inlining into a message.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": { "file": { "type": "string", "format": "binary" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extracted text",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "filename": "notes.pdf", "text": "…" },
                  "properties": {
                    "filename": { "type": "string" },
                    "text":     { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing or non-PDF file", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "501": { "description": "PDF extraction unavailable on the server" }
        }
      }
    }
  }
}
