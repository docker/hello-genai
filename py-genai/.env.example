# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of your LLM backend (OpenAI-compatible /chat/completions endpoint)
LLAMA_URL=http://127.0.0.1:12434/engines/llama.cpp/v1

# Model name to use for inference
LLAMA_MODEL=docker.io/ai/gemma4:latest

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated list of models shown in the UI dropdown
AVAILABLE_MODELS=docker.io/ai/gemma4:latest,docker.io/ai/gemma3n:latest

# Port the app listens on (default: 8081)
PORT=8081

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Path to the SQLite database file (default: chat_history.db)
DATABASE_PATH=chat_history.db

# LLM request timeout in seconds (default: 60)
LLM_TIMEOUT=60

# Number of retries on transient LLM errors (default: 2)
LLM_MAX_RETRIES=2

# Enable Flask debug mode — never use true in production (default: false)
DEBUG=false

# Approximate token budget for conversation context sent to the model.
# Oldest turns are trimmed first. Set below your model's context_size,
# leaving headroom for the response (default: 3000)
LLM_CONTEXT_MAX_TOKENS=3000

# Maximum user message length in characters (default: 32000)
MAX_MESSAGE_LEN=32000

# Rate limiter storage. The in-memory default is per-process — when running
# gunicorn with multiple workers, point this at a shared store,
# e.g. redis://localhost:6379 (default: memory://)
RATE_LIMIT_STORAGE_URI=memory://
