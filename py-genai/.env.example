# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of your LLM backend (OpenAI-compatible /chat/completions endpoint)
LLAMA_URL=http://127.0.0.1:12434/engines/llama.cpp/v1

# Model name to use for inference
LLAMA_MODEL=docker.io/ai/gemma4:latest

# ── Optional ──────────────────────────────────────────────────────────────────
# Comma-separated list of models shown in the UI dropdown
AVAILABLE_MODELS=docker.io/ai/gemma4:latest,docker.io/ai/gemma3n:latest

# Port the app listens on (default: 8081)
PORT=8081

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Path to the SQLite database file (default: chat_history.db)
DATABASE_PATH=chat_history.db

# LLM request timeout in seconds (default: 60)
LLM_TIMEOUT=60

# Number of retries on transient LLM errors (default: 2)
LLM_MAX_RETRIES=2

# Enable Flask debug mode — never use true in production (default: false)
DEBUG=false

# Approximate token budget for conversation context sent to the model.
# Oldest turns are trimmed first. Set below your model's context_size,
# leaving headroom for the response (default: 3000)
LLM_CONTEXT_MAX_TOKENS=3000

# Maximum user message length in characters (default: 32000)
MAX_MESSAGE_LEN=32000

# Rate limiter storage. The in-memory default is per-process — when running
# gunicorn with multiple workers, point this at a shared store,
# e.g. redis://localhost:6379 (default: memory://)
RATE_LIMIT_STORAGE_URI=memory://

# ── Optional authentication ───────────────────────────────────────────────────
# Set APP_API_KEY to require a login for the UI and an Authorization: Bearer /
# X-API-Key header for the API. Leave blank (default) to run open.
APP_API_KEY=
# Secret used to sign the login session cookie. A random value is generated per
# process if unset (sessions won't survive restarts). Set a fixed value in prod.
SECRET_KEY=

# ── Attachments ───────────────────────────────────────────────────────────────
# Max images per message (sent to vision-capable models)
MAX_IMAGES_PER_MESSAGE=4
# Max size per attached image, in bytes (default 4 MB)
MAX_IMAGE_BYTES=4194304
# Max total upload size for the PDF extractor, in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# ── Persistent chat memory ────────────────────────────────────────────────────
# The assistant extracts durable facts about you (via your local model) and
# recalls them in every conversation. Set false to disable entirely.
MEMORY_ENABLED=true
# Maximum stored memories; extraction stops when full (default 100)
MEMORY_MAX_ITEMS=100

# ── Embeddings (RAG, semantic memory recall) ──────────────────────────────────
# Point EMBED_MODEL at an embedding model served by an OpenAI-compatible
# /embeddings endpoint. Blank = embeddings disabled (RAG stores docs without
# retrieval; memory falls back to injecting all enabled facts).
EMBED_MODEL=
# Defaults to LLAMA_URL if unset
EMBED_URL=
MEMORY_RECALL_K=8
RAG_RETRIEVE_K=4
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150

# ── Tool / function calling ───────────────────────────────────────────────────
# Lets the model call safe built-in tools (calculator, current time, search past
# chats, retrieve documents). Requires a backend that supports the tools param.
TOOLS_ENABLED=true
TOOLS_MAX_STEPS=4
